{
  "name": "trakman",
  "version": "1.6.2",
  "private": "true",
  "license": "MIT",
  "homepage": "http://github.com/lythx/trakman",
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "dotenv": "^17.4.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "pm2": "^7.0.3",
    "typescript": "^7.0.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/xml2js": "^0.4.14",
    "ts-node": "^10.9.2"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./built/src/Main.js",
    "daemon": "pm2 start ./built/src/Main.js --attach --name Trakman",
    "restart": "pm2 restart ./built/src/Main.js",
    "stop": "pm2 delete ./built/src/Main.js"
  },
  "type": "module"
}
